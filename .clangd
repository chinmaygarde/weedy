# Zephyr writes compile_commands.json into the workspace build dir. Run clangd
# with --query-driver='**/arm-zephyr-eabi-*' so it picks up the Zephyr SDK
# GCC's target and system headers (including libstdc++).
CompileFlags:
  CompilationDatabase: ../build
  # GCC-only flags that clang rejects. Zephyr adds -fno-printf-return-value
  # to C files only.
  Remove: [-fno-reorder-functions, -mfp16-format=*, -fno-printf-return-value]
Diagnostics:
  # Zephyr's log macros (Z_LOG_MSG_ON_STACK_ALLOC) build messages in a
  # runtime-sized stack array. GCC accepts this silently in C++; clang warns.
  Suppress: [vla-cxx-extension]
